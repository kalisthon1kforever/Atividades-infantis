# Copie para .env e preencha os valores reais.
# NUNCA commite o arquivo .env no Git.

# Vercel
VERCEL_TOKEN=
VERCEL_USER=
VERCEL_TEAM_ID=

# GitHub
GITHUB_TOKEN=
GITHUB_USER=

# Supabase
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# E-mail transacional da amostra e do acesso pago (Resend)
RESEND_API_KEY=
QUIZ_FROM_EMAIL=Pequenos Passos <onboarding@resend.dev>
QUIZ_REPLY_TO=atividadesinfantis84@gmail.com
# Com os dois abaixo, o e-mail sai pelo Gmail (remetente = GMAIL_USER) e o Resend fica de lado.
# GMAIL_APP_PASSWORD é a "senha de app" de 16 letras do Google, não a senha da conta.
GMAIL_USER=atividadesinfantis84@gmail.com
GMAIL_APP_PASSWORD=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
QUIZ_LEAD_WEBHOOK=

# Mercado Pago — checkout próprio. O Access Token e o Client Secret ficam só aqui, nunca no navegador.
# NEXT_PUBLIC_SITE_URL precisa ser https público para o retorno e o webhook avisarem o app.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
